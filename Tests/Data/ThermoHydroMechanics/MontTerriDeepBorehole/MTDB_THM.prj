    <time_loop>
        <processes>
            <process ref="MT_DB">
                <nonlinear_solver>basic_newton</nonlinear_solver>
                <convergence_criterion>
                    <type>PerComponentDeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <reltols>1e-6 1e-6 1e-6 1e-6</reltols>
                </convergence_criterion>
                <time_discretization>
                    <type>BackwardEuler</type>
                </time_discretization>
                <time_stepping>
                    <type>FixedTimeStepping</type>
                    <t_initial>0</t_initial>
                    <t_end>3.1536e15</t_end>
                    <timesteps>
                        <pair>
                            <repeat>1</repeat>
                            <delta_t>3.1536e15</delta_t>
                        </pair>
                    </timesteps>
                </time_stepping>
            </process>
        </processes>
        <output>
            <type>VTK</type>
            <prefix>MTDB_THM_Modified</prefix>
            <suffix>_ts_{:timestep}_t_{:time}_i_{:iteration}</suffix>
            <timesteps>
                <pair>
                    <repeat>1</repeat>
                    <each_steps>1</each_steps>
                </pair>
            </timesteps>
            <!--Needed: T RH Pw d_x d_y e_x e_y-->
            <variables>
            </variables>
        </output>
    </time_loop>
    <parameters>
        <parameter>
            <name>YoungsModuliClay</name>
            <type>Constant</type>
            <!--xx yy zz-->
            <!--xx is perpendicular, yy and zz are parallel-->
            <value>3.5e8</value>
        </parameter>
        <parameter>
            <name>PoissonsRatiosClay</name>
            <type>Constant</type>
            <!--xy yz xz-->
            <!--2D: xy is perpendicular, yz parallel,
                    xz is perpendicular-->
            <value>0.125</value>
        </parameter>
        <parameter>
            <name>displacement_ic</name>
            <type>Constant</type>
            <values>0 0</values>
        </parameter>
        <parameter>
            <name>dirichlet</name>
            <type>Constant</type>
            <value>0</value>
        </parameter>
        <parameter>
            <name>sigma_ic</name>
            <type>Constant</type>
            <values>0 0 0 0</values>
            <!--values>3.5e6 0.7854 0 0</values-->
        </parameter>
        <parameter>
            <name>p_grad</name>
            <type>Function</type>
            <expression>-0.006320e6*y+0.562e6</expression>
        </parameter>
        <parameter>
            <name>p_bc_upper</name>
            <type>Constant</type>
            <!-- at y=-37-->
            <value>0.562e6</value>
        </parameter>
        <parameter>
            <name>p_bc_bottom</name>
            <type>Constant</type>
            <value>2.463e6</value>
        </parameter>
        <parameter>
            <name>T_bc_top</name>
            <type>Constant</type>
            <!--value>273.15+12.43</value-->
            <value>285.58</value>
        </parameter>
        <parameter>
            <name>T_bc_bottom</name>
            <type>Constant</type>
            <!--value>273.15+29.17</value-->
            <value>302.32</value>
        </parameter>
        <parameter>
            <name>T_init</name>
            <type>MeshNode</type>
            <mesh>domain</mesh>
            <field_name>T_init</field_name>
        </parameter>
    </parameters>
    <process_variables>
        <process_variable>
            <name>displacement</name>
            <components>2</components>
            <order>1</order>
            <compensate_non_equilibrium_initial_residuum>true</compensate_non_equilibrium_initial_residuum>
            <initial_condition>displacement_ic</initial_condition>
            <boundary_conditions>
                <boundary_condition>
                    <mesh>domain</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>dirichlet</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>domain</mesh>
                    <type>Dirichlet</type>
                    <component>1</component>
                    <parameter>dirichlet</parameter>
                </boundary_condition>
            </boundary_conditions>
        </process_variable>
        <process_variable>
            <name>pressure</name>
            <components>1</components>
            <order>1</order>
            <initial_condition>p_grad</initial_condition>
            <boundary_conditions>
                <boundary_condition>
                    <mesh>Hauptrogenstein</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>p_grad</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>Upper_boundary</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>p_bc_upper</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>Bottom_boundary</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>p_bc_bottom</parameter>
                </boundary_condition>
            </boundary_conditions>
        </process_variable>
        <process_variable>
            <name>temperature</name>
            <components>1</components>
            <order>1</order>
            <initial_condition>T_init</initial_condition>
            <boundary_conditions>
                <boundary_condition>
                    <mesh>Bottom_boundary</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>T_bc_bottom</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>Upper_boundary</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>T_bc_top</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>domain</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>T_init</parameter>
                </boundary_condition>
            </boundary_conditions>
        </process_variable>
    </process_variables>
    <nonlinear_solvers>
        <nonlinear_solver>
            <name>basic_newton</name>
            <type>Newton</type>
            <max_iter>100</max_iter>
            <linear_solver>linear_solver</linear_solver>
        </nonlinear_solver>
    </nonlinear_solvers>
    <linear_solvers>
        <linear_solver>
            <name>linear_solver</name>
            <eigen>
                <solver_type>SparseLU</solver_type>
            </eigen>
        </linear_solver>
    </linear_solvers>
</OpenGeoSysProject>
