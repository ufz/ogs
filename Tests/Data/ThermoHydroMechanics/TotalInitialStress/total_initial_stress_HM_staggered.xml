<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProjectDiff base_file="total_initial_stress_HM.prj">
    <!-- Staggered variant: the conversion of the total initial stress into
         the effective stress uses the pressure, which the hydraulic process
         sets before the mechanical one. Compared against the monolithic
         reference results. -->
    <replace msel="/*/time_loop/output/prefix/text()">total_initial_stress_HM_staggered</replace>

    <add sel="/*/processes/process[1]">
        <coupling_scheme>
            <type>staggered</type>
        </coupling_scheme>
    </add>
    <add sel="/*/time_loop">
        <global_process_coupling>
            <max_iter>50</max_iter>
            <convergence_criteria>
                <!-- convergence criterion for T -->
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1.e-10</abstol>
                </convergence_criterion>
                <!-- convergence criterion for H -->
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1.e-10</abstol>
                    <reltol>1.e-14</reltol>
                </convergence_criterion>
                <!-- convergence criterion for M -->
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1.e-14</abstol>
                    <reltol>1.e-14</reltol>
                </convergence_criterion>
            </convergence_criteria>
        </global_process_coupling>
    </add>

    <remove sel="/*/time_loop/processes/process[1]"/>

    <add sel="/*/time_loop/processes">
        <!-- T -->
        <process ref="HM">
            <nonlinear_solver>basic_newton</nonlinear_solver>
            <convergence_criterion>
                <type>DeltaX</type>
                <norm_type>NORM2</norm_type>
                <abstol>1e-9</abstol>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>1e6</t_end>
                <timesteps>
                    <pair>
                        <repeat>1</repeat>
                        <delta_t>1e6</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
        <!-- H -->
        <process ref="HM">
            <nonlinear_solver>basic_newton</nonlinear_solver>
            <convergence_criterion>
                <type>DeltaX</type>
                <norm_type>NORM2</norm_type>
                <abstol>1e-9</abstol>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>1e6</t_end>
                <timesteps>
                    <pair>
                        <repeat>1</repeat>
                        <delta_t>1e6</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
        <!-- M -->
        <process ref="HM">
            <nonlinear_solver>basic_newton</nonlinear_solver>
            <convergence_criterion>
                <type>PerComponentDeltaX</type>
                <norm_type>NORM2</norm_type>
                <abstols>1e-9 1e-9 1e-9</abstols>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>1e6</t_end>
                <timesteps>
                    <pair>
                        <repeat>1</repeat>
                        <delta_t>1e6</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
    </add>

    <remove sel="/*/test_definition"/>
    <add sel="/*">
        <test_definition>
            <vtkdiff>
                <file>total_initial_stress_HM_staggered_ts_0_t_0.000000.vtu</file>
                <reference_file>total_initial_stress_HM_ts_0_t_0.000000.vtu</reference_file>
                <field>sigma</field>
                <absolute_tolerance>1.0e-8</absolute_tolerance>
                <relative_tolerance>1.e-10</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>total_initial_stress_HM_staggered_ts_1_t_1000000.000000.vtu</file>
                <reference_file>total_initial_stress_HM_ts_1_t_1000000.000000.vtu</reference_file>
                <field>pressure</field>
                <absolute_tolerance>1.0e-8</absolute_tolerance>
                <relative_tolerance>1.e-10</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>total_initial_stress_HM_staggered_ts_1_t_1000000.000000.vtu</file>
                <reference_file>total_initial_stress_HM_ts_1_t_1000000.000000.vtu</reference_file>
                <field>sigma</field>
                <absolute_tolerance>1.0e-6</absolute_tolerance>
                <relative_tolerance>1.e-10</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
</OpenGeoSysProjectDiff>
