<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProjectDiff base_file="UnitSquare.prj">
    <replace msel="/*/time_loop/output/prefix/text()">
        Results_staggered
    </replace>

    <add sel="/*/processes/process[1]">
        <coupling_scheme>
            <type>staggered</type>
            <fixed_stress_stabilization_parameter>0.0</fixed_stress_stabilization_parameter>
        </coupling_scheme>
    </add>
    <add sel="/*/time_loop">
        <global_process_coupling>
            <max_iter> 20 </max_iter>
            <convergence_criteria>
                <!-- convergence criterion for T -->
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1.e-14</abstol>
                    <reltol>1.e-08</reltol>
                </convergence_criterion>
                <!-- convergence criterion for H -->
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1.e-10</abstol>
                    <reltol>1.e-9</reltol>
                </convergence_criterion>
                <!-- convergence criterion for M -->
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1.e-14</abstol>
                    <reltol>1.0e-10</reltol>
                </convergence_criterion>
            </convergence_criteria>
        </global_process_coupling>
    </add>

    <remove sel="/*/time_loop/processes/process[1]"/>

    <add sel="/*/time_loop/processes">
        <!-- T -->
        <process ref="THERMO_HYDRO_MECHANICS">
            <nonlinear_solver>basic_newton_T</nonlinear_solver>
            <convergence_criterion>
                <type>DeltaX</type>
                <norm_type>NORM2</norm_type>
                <abstol>1.0</abstol>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>3600</t_end> <!-- 1 h -->
                <timesteps>
                    <pair>
                        <repeat>60</repeat>
                        <delta_t>60</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
        <!-- H -->
        <process ref="THERMO_HYDRO_MECHANICS">
            <nonlinear_solver>basic_newton_p</nonlinear_solver>
            <convergence_criterion>
                <type>DeltaX</type>
                <norm_type>NORM2</norm_type>
                <reltol>1.0</reltol>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>3600</t_end> <!-- 1 h -->
                <timesteps>
                    <pair>
                        <repeat>60</repeat>
                        <delta_t>60</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
        <process ref="THERMO_HYDRO_MECHANICS">
            <!-- M -->
            <nonlinear_solver>basic_newton_u</nonlinear_solver>
            <convergence_criterion>
                <type>PerComponentDeltaX</type>
                <norm_type>NORM2</norm_type>
                <reltols>1e-8 1e-8</reltols>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>3600</t_end> <!-- 1 h -->
                <timesteps>
                    <pair>
                        <repeat>60</repeat>
                        <delta_t>60</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
    </add>

    <remove sel="/*/nonlinear_solvers/nonlinear_solver"/>

    <add sel="/*/nonlinear_solvers">
        <nonlinear_solver>
            <name>basic_newton_T</name>
            <type>Newton</type>
            <max_iter>50</max_iter>
            <linear_solver>general_linear_solver_T</linear_solver>
        </nonlinear_solver>
        <nonlinear_solver>
            <name>basic_newton_p</name>
            <type>Newton</type>
            <max_iter>50</max_iter>
            <linear_solver>general_linear_solver_p</linear_solver>
        </nonlinear_solver>
        <nonlinear_solver>
            <name>basic_newton_u</name>
            <type>Newton</type>
            <max_iter>50</max_iter>
            <linear_solver>general_linear_solver_u</linear_solver>
        </nonlinear_solver>
    </add>

    <remove sel="/*/linear_solvers/linear_solver"/>

    <add sel="/*/linear_solvers">
        <linear_solver>
            <name>general_linear_solver_T</name>
            <eigen>
                <solver_type>BiCGSTAB</solver_type>
                <precon_type>ILUT</precon_type>
                <max_iteration_step>3000</max_iteration_step>
                <error_tolerance>1e-20</error_tolerance>
                <scaling>1</scaling>
            </eigen>
        </linear_solver>
        <linear_solver>
            <name>general_linear_solver_p</name>
            <eigen>
                <solver_type>BiCGSTAB</solver_type>
                <precon_type>ILUT</precon_type>
                <max_iteration_step>3000</max_iteration_step>
                <error_tolerance>1e-8</error_tolerance>
                <scaling>1</scaling>
            </eigen>
        </linear_solver>
        <linear_solver>
            <name>general_linear_solver_u</name>
            <eigen>
                <solver_type>SparseLU</solver_type>
                <scaling>true</scaling>
            </eigen>
        </linear_solver>
    </add>

    <!-- Compare the staggered solution against the monolithic reference at the
         two time steps covering the freezing and the fully frozen state. -->
    <remove sel="/*/test_definition"/>
    <add sel="/*">
        <test_definition>
            <vtkdiff>
                <file>Results_staggered_ts_32_t_1920_sec.vtu</file>
                <reference_file>Results_ts_32_t_1920_sec.vtu</reference_file>
                <field>displacement</field>
                <absolute_tolerance>1.0e-16</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_32_t_1920_sec.vtu</file>
                <reference_file>Results_ts_32_t_1920_sec.vtu</reference_file>
                <field>epsilon</field>
                <absolute_tolerance>1.e-15</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_32_t_1920_sec.vtu</file>
                <reference_file>Results_ts_32_t_1920_sec.vtu</reference_file>
                <field>sigma</field>
                <absolute_tolerance>2e-14</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_32_t_1920_sec.vtu</file>
                <reference_file>Results_ts_32_t_1920_sec.vtu</reference_file>
                <field>sigma_ice_ip</field>
                <absolute_tolerance>2.0e-6</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_32_t_1920_sec.vtu</file>
                <reference_file>Results_ts_32_t_1920_sec.vtu</reference_file>
                <field>sigma_ice_avg</field>
                <absolute_tolerance>5.0e-7</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_32_t_1920_sec.vtu</file>
                <reference_file>Results_ts_32_t_1920_sec.vtu</reference_file>
                <field>ice_volume_fraction</field>
                <absolute_tolerance>4e-14</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_32_t_1920_sec.vtu</file>
                <reference_file>Results_ts_32_t_1920_sec.vtu</reference_file>
                <field>ice_volume_fraction_ip</field>
                <absolute_tolerance>4e-14</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_32_t_1920_sec.vtu</file>
                <reference_file>Results_ts_32_t_1920_sec.vtu</reference_file>
                <field>ice_volume_fraction_avg</field>
                <absolute_tolerance>4e-14</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_60_t_3600_sec.vtu</file>
                <reference_file>Results_ts_60_t_3600_sec.vtu</reference_file>
                <field>displacement</field>
                <absolute_tolerance>1.0e-16</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_60_t_3600_sec.vtu</file>
                <reference_file>Results_ts_60_t_3600_sec.vtu</reference_file>
                <field>epsilon</field>
                <absolute_tolerance>1.e-15</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_60_t_3600_sec.vtu</file>
                <reference_file>Results_ts_60_t_3600_sec.vtu</reference_file>
                <field>sigma</field>
                <absolute_tolerance>2e-14</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_60_t_3600_sec.vtu</file>
                <reference_file>Results_ts_60_t_3600_sec.vtu</reference_file>
                <field>sigma_ice_ip</field>
                <absolute_tolerance>1.75e-7</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_60_t_3600_sec.vtu</file>
                <reference_file>Results_ts_60_t_3600_sec.vtu</reference_file>
                <field>sigma_ice_avg</field>
                <absolute_tolerance>6e-8</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_60_t_3600_sec.vtu</file>
                <reference_file>Results_ts_60_t_3600_sec.vtu</reference_file>
                <field>ice_volume_fraction</field>
                <absolute_tolerance>4e-14</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_60_t_3600_sec.vtu</file>
                <reference_file>Results_ts_60_t_3600_sec.vtu</reference_file>
                <field>ice_volume_fraction_ip</field>
                <absolute_tolerance>4e-14</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>Results_staggered_ts_60_t_3600_sec.vtu</file>
                <reference_file>Results_ts_60_t_3600_sec.vtu</reference_file>
                <field>ice_volume_fraction_avg</field>
                <absolute_tolerance>4e-14</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
 </OpenGeoSysProjectDiff>
