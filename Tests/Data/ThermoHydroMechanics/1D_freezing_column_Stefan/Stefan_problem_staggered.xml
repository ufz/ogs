<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProjectDiff base_file="Stefan_problem.prj">
    <replace msel="/*/time_loop/output/prefix/text()">
        Stefan_problem_staggered
    </replace>

    <add sel="/*/processes/process[1]">
        <coupling_scheme>
            <type>staggered</type>
            <fixed_stress_stabilization_parameter>0.0</fixed_stress_stabilization_parameter>
        </coupling_scheme>
    </add>
    <add sel="/*/time_loop">
        <global_process_coupling>
            <max_iter> 20 </max_iter>
            <convergence_criteria>
                <!-- convergence criterion for T -->
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1.e-14</abstol>
                    <reltol>1.e-08</reltol>
                </convergence_criterion>
                <!-- convergence criterion for H -->
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1.e-10</abstol>
                    <reltol>1.e-9</reltol>
                </convergence_criterion>
                <!-- convergence criterion for M -->
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1.e-14</abstol>
                    <reltol>1.0e-10</reltol>
                </convergence_criterion>
            </convergence_criteria>
        </global_process_coupling>
    </add>

    <remove sel="/*/time_loop/processes/process[1]"/>

    <add sel="/*/time_loop/processes">
        <!-- T -->
        <process ref="HeatConduction">
            <nonlinear_solver>basic_newton_T</nonlinear_solver>
            <convergence_criterion>
                <type>DeltaX</type>
                <norm_type>NORM2</norm_type>
                <abstol>1e-5</abstol>
                <reltol>1e-15</reltol>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>427000000</t_end>
                <timesteps>
                    <pair>
                        <repeat>10</repeat>
                        <delta_t>5e5</delta_t>
                    </pair>
                    <pair>
                        <repeat>422</repeat>
                        <delta_t>1e6</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
        <!-- H -->
        <process ref="HeatConduction">
            <nonlinear_solver>basic_newton_p</nonlinear_solver>
            <convergence_criterion>
                <type>DeltaX</type>
                <norm_type>NORM2</norm_type>
                <abstol>1e-5</abstol>
                <reltol>1e-13</reltol>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>427000000</t_end>
                <timesteps>
                    <pair>
                        <repeat>10</repeat>
                        <delta_t>5e5</delta_t>
                    </pair>
                    <pair>
                        <repeat>422</repeat>
                        <delta_t>1e6</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
        <process ref="HeatConduction">
            <!-- M -->
            <nonlinear_solver>basic_newton_u</nonlinear_solver>
            <convergence_criterion>
                <type>PerComponentDeltaX</type>
                <norm_type>NORM2</norm_type>
                <abstols>1e-5 1e-5</abstols>
                <reltols>1e-14 1e-14</reltols>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>427000000</t_end>
                <timesteps>
                    <pair>
                        <repeat>10</repeat>
                        <delta_t>5e5</delta_t>
                    </pair>
                    <pair>
                        <repeat>422</repeat>
                        <delta_t>1e6</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
    </add>

    <remove sel="/*/nonlinear_solvers/nonlinear_solver"/>

    <add sel="/*/nonlinear_solvers">
        <nonlinear_solver>
            <name>basic_newton_T</name>
            <type>Newton</type>
            <damping>0.94</damping>
            <damping_reduction>10</damping_reduction>
            <!-- Many iterations are needed for the first time step. -->
            <max_iter>800</max_iter>
            <linear_solver>general_linear_solver_T</linear_solver>
        </nonlinear_solver>
        <nonlinear_solver>
            <name>basic_newton_p</name>
            <type>Newton</type>
            <max_iter>50</max_iter>
            <linear_solver>general_linear_solver_p</linear_solver>
        </nonlinear_solver>
        <nonlinear_solver>
            <name>basic_newton_u</name>
            <type>Newton</type>
            <max_iter>50</max_iter>
            <linear_solver>general_linear_solver_u</linear_solver>
        </nonlinear_solver>
    </add>

    <remove sel="/*/linear_solvers/linear_solver"/>

    <add sel="/*/linear_solvers">
        <linear_solver>
            <name>general_linear_solver_T</name>
            <eigen>
                <solver_type>BiCGSTAB</solver_type>
                <precon_type>ILUT</precon_type>
                <max_iteration_step>10000</max_iteration_step>
                <error_tolerance>1e-20</error_tolerance>
                <scaling>1</scaling>
            </eigen>
        </linear_solver>
        <linear_solver>
            <name>general_linear_solver_p</name>
            <eigen>
                <solver_type>BiCGSTAB</solver_type>
                <precon_type>ILUT</precon_type>
                <max_iteration_step>10000</max_iteration_step>
                <error_tolerance>1e-8</error_tolerance>
                <scaling>1</scaling>
            </eigen>
        </linear_solver>
        <linear_solver>
            <name>general_linear_solver_u</name>
            <eigen>
                <solver_type>BiCGSTAB</solver_type>
                <precon_type>ILUT</precon_type>
                <max_iteration_step>10000</max_iteration_step>
                <error_tolerance>1e-8</error_tolerance>
                <scaling>1</scaling>
            </eigen>
        </linear_solver>
    </add>

    <!-- Compare the staggered solution against the monolithic reference at the
         final time step. -->
    <remove sel="/*/test_definition"/>
    <add sel="/*">
        <test_definition>
            <!--primary field-->
            <vtkdiff>
                <file>Stefan_problem_staggered_ts_432_t_427000000.000000.vtu</file>
                <reference_file>Stefan_problem_ts_432_t_427000000.000000.vtu</reference_file>
                <field>temperature</field>
                <absolute_tolerance>7.0e-8</absolute_tolerance>
                <relative_tolerance>2.5e-10</relative_tolerance>
            </vtkdiff>
            <!--secondary field-->
            <vtkdiff>
                <file>Stefan_problem_staggered_ts_432_t_427000000.000000.vtu</file>
                <reference_file>Stefan_problem_ts_432_t_427000000.000000.vtu</reference_file>
                <field>HeatFlowRate</field>
                <absolute_tolerance>1.5e-8</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <!--cell field-->
            <vtkdiff>
                <file>Stefan_problem_staggered_ts_432_t_427000000.000000.vtu</file>
                <reference_file>Stefan_problem_ts_432_t_427000000.000000.vtu</reference_file>
                <field>sensible_heat</field>
                <absolute_tolerance>0.0</absolute_tolerance>
                <relative_tolerance>8.0e-9</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
 </OpenGeoSysProjectDiff>
