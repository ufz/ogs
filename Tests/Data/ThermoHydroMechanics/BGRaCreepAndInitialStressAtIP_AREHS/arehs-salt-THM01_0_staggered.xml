<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProjectDiff base_file="arehs-salt-THM01_0.prj">
    <replace msel="/*/time_loop/output/prefix/text()">
        arehs-salt-THM0_staggered
    </replace>

    <add sel="/*/processes/process[1]">
        <coupling_scheme>
            <type>staggered</type>
            <fixed_stress_stabilization_parameter>0.8</fixed_stress_stabilization_parameter>
        </coupling_scheme>
    </add>
    <add sel="/*/time_loop">
        <global_process_coupling>
            <max_iter> 20 </max_iter>
            <convergence_criteria>
                <!-- convergence criterion for T -->
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1.e-14</abstol>
                    <reltol>1.e-08</reltol>
                </convergence_criterion>
                <!-- convergence criterion for H -->
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1.e-10</abstol>
                    <reltol>1.e-9</reltol>
                </convergence_criterion>
                <!-- convergence criterion for M -->
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1.e-14</abstol>
                    <reltol>1.0e-10</reltol>
                </convergence_criterion>
            </convergence_criteria>
        </global_process_coupling>
    </add>
    
    <remove sel="/*/time_loop/processes/process[1]"/>
    
    <add sel="/*/time_loop/processes">
        <!-- T -->
        <process ref="THM">
            <nonlinear_solver>basic_newton_T</nonlinear_solver>
            <convergence_criterion>
                <type>DeltaX</type>
                <norm_type>NORM2</norm_type>
                <abstol>1e-5</abstol>
                <reltol>1e-15</reltol>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>15.768e+10</t_end>
                <!-- 50k years-->
                <timesteps>
                    <pair>
                        <repeat>5</repeat>
                        <delta_t>3.1536e10</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
        <!-- H -->
        <process ref="THM">
            <nonlinear_solver>basic_newton_p</nonlinear_solver>
            <convergence_criterion>
                <type>DeltaX</type>
                <norm_type>NORM2</norm_type>
                <abstol>1e-5</abstol>
                <reltol>1e-13</reltol>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>15.768e+10</t_end>
                <!-- 50k years-->
                <timesteps>
                    <pair>
                        <repeat>5</repeat>
                        <delta_t>3.1536e10</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
        <process ref="THM">
            <!-- M -->
            <nonlinear_solver>basic_newton_u</nonlinear_solver>
            <convergence_criterion>
                <type>PerComponentDeltaX</type>
                <norm_type>NORM2</norm_type>
                <abstols>1e-5 1e-5</abstols>
                <reltols>1e-14 1e-14</reltols>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>15.768e+10</t_end>
                <!-- 50k years-->
                <timesteps>
                    <pair>
                        <repeat>5</repeat>
                        <delta_t>3.1536e10</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
    </add>

    <remove sel="/*/nonlinear_solvers/nonlinear_solver"/>
   
    <add sel="/*/nonlinear_solvers">
        <nonlinear_solver>
            <name>basic_newton_T</name>
            <type>Newton</type>
            <max_iter>50</max_iter>
            <linear_solver>general_linear_solver_T</linear_solver>
        </nonlinear_solver>
        <nonlinear_solver>
            <name>basic_newton_p</name>
            <type>Newton</type>
            <max_iter>50</max_iter>
            <linear_solver>general_linear_solver_p</linear_solver>
        </nonlinear_solver>
        <nonlinear_solver>
            <name>basic_newton_u</name>
            <type>Newton</type>
            <max_iter>50</max_iter>
            <linear_solver>general_linear_solver_u</linear_solver>
        </nonlinear_solver>
    </add>

    <remove sel="/*/linear_solvers/linear_solver"/>

    <add sel="/*/linear_solvers">
        <linear_solver>
            <name>general_linear_solver_T</name>
            <lis>-i bicgstab -p ilu -tol 1e-16 -maxiter 10000</lis>
            <eigen>
                <solver_type>BiCGSTAB</solver_type>
                <precon_type>ILUT</precon_type>
                <max_iteration_step>10000</max_iteration_step>
                <error_tolerance>1e-8</error_tolerance>
                <scaling>1</scaling>
            </eigen>
            <petsc>
                <prefix>sd</prefix>
                <parameters>-sd_ksp_type cg -sd_pc_type bjacobi -sd_ksp_rtol 1e-16 -sd_ksp_max_it 10000</parameters>
            </petsc>
        </linear_solver>
        <linear_solver>
            <name>general_linear_solver_p</name>
            <lis>-i bicgstab -p ilu -tol 1e-16 -maxiter 10000</lis>
            <eigen>
                <solver_type>BiCGSTAB</solver_type>
                <precon_type>ILUT</precon_type>
                <max_iteration_step>10000</max_iteration_step>
                <error_tolerance>1e-8</error_tolerance>
                <scaling>1</scaling>
            </eigen>
            <petsc>
                <prefix>sd</prefix>
                <parameters>-sd_ksp_type cg -sd_pc_type bjacobi -sd_ksp_rtol 1e-16 -sd_ksp_max_it 10000</parameters>
            </petsc>
        </linear_solver>
        <linear_solver>
            <name>general_linear_solver_u</name>
            <lis>-i bicgstab -p ilu -tol 1e-16 -maxiter 10000</lis>
            <eigen>
                <solver_type>BiCGSTAB</solver_type>
                <precon_type>ILUT</precon_type>
                <max_iteration_step>10000</max_iteration_step>
                <error_tolerance>1e-8</error_tolerance>
                <scaling>1</scaling>
            </eigen>
            <petsc>
                <prefix>sd</prefix>
                <parameters>-sd_ksp_type cg -sd_pc_type bjacobi -sd_ksp_rtol 1e-16 -sd_ksp_max_it 10000</parameters>
            </petsc>
        </linear_solver>
    </add>

    <!-- Compare against the monolithic reference; the pressure and sigma
         relative tolerances are looser than in the base project file to
         accommodate the staggered coupling. -->
    <remove sel="/*/test_definition"/>
    <add sel="/*">
        <test_definition>
            <vtkdiff>
                <file>arehs-salt-THM0_staggered_ts_5_t_157680000000.000000.vtu</file>
                <reference_file>arehs-salt-THM0_ts_5_t_157680000000.000000.vtu</reference_file>
                <field>displacement</field>
                <absolute_tolerance>1e-8</absolute_tolerance>
                <relative_tolerance>1e-8</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>arehs-salt-THM0_staggered_ts_5_t_157680000000.000000.vtu</file>
                <reference_file>arehs-salt-THM0_ts_5_t_157680000000.000000.vtu</reference_file>
                <field>pressure</field>
                <absolute_tolerance>1e-8</absolute_tolerance>
                <relative_tolerance>2.0e-6</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>arehs-salt-THM0_staggered_ts_5_t_157680000000.000000.vtu</file>
                <reference_file>arehs-salt-THM0_ts_5_t_157680000000.000000.vtu</reference_file>
                <field>temperature</field>
                <absolute_tolerance>1e-8</absolute_tolerance>
                <relative_tolerance>1e-8</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>arehs-salt-THM0_staggered_ts_5_t_157680000000.000000.vtu</file>
                <reference_file>arehs-salt-THM0_ts_5_t_157680000000.000000.vtu</reference_file>
                <field>epsilon</field>
                <absolute_tolerance>1e-8</absolute_tolerance>
                <relative_tolerance>1e-8</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>arehs-salt-THM0_staggered_ts_5_t_157680000000.000000.vtu</file>
                <reference_file>arehs-salt-THM0_ts_5_t_157680000000.000000.vtu</reference_file>
                <field>sigma</field>
                <absolute_tolerance>1.0e-5</absolute_tolerance>
                <relative_tolerance>1.5e-5</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
 </OpenGeoSysProjectDiff>
