<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProject>
    <time_loop>
        <include file="steady_state_diffusion.include"/>
        <output>
            <type>XDMF</type>
            <prefix>cube_1e3_np3</prefix>
            <variables>
                <variable> pressure </variable>
                <variable> v      </variable>
            </variables>
            <suffix>_ts_{:timestep}_t_{:time}</suffix>
            <hdf>
                <number_of_files>3</number_of_files>
                <chunk_size_bytes>1048576</chunk_size_bytes>
            </hdf>
        </output>
    </time_loop>
    <include file="cube_1e3.include"/>
    <test_definition>
        <xdmfdiff>
            <reference_file>XDMF_NP3_3/cube_1e3_np3_cube_1x1x1_hex_1e3.xdmf</reference_file>
            <file>cube_1e3_np3_cube_1x1x1_hex_1e3.xdmf</file>
            <field>pressure</field>
            <absolute_tolerance>1e-3</absolute_tolerance>
            <relative_tolerance>1e-3</relative_tolerance>
            <reference_timestep>1</reference_timestep>
            <timestep>1</timestep>
        </xdmfdiff>
        <xdmfdiff>
            <reference_file>XDMF_NP3_3/cube_1e3_np3_cube_1x1x1_hex_1e3.xdmf</reference_file>
            <file>cube_1e3_np3_cube_1x1x1_hex_1e3.xdmf</file>
            <field>v</field>
            <absolute_tolerance>1e-3</absolute_tolerance>
            <relative_tolerance>1e-3</relative_tolerance>
            <reference_timestep>1</reference_timestep>
            <timestep>1</timestep>
        </xdmfdiff>
    </test_definition>
</OpenGeoSysProject>
