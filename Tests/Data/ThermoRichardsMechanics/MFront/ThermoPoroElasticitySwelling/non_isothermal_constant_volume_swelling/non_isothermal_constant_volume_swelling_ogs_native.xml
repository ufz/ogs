<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProjectDiff base_file="non_isothermal_constant_volume_swelling_mfront.prj">
    <remove sel="/*/processes/process/subtype"/>
    <remove sel="/*/processes/process/constitutive_relation/type"/>
    <remove sel="/*/processes/process/constitutive_relation/behaviour"/>
    <remove sel="/*/processes/process/constitutive_relation/material_properties"/>
    <add sel="/*/processes/process/constitutive_relation">
        <type>LinearElasticIsotropic</type>
        <youngs_modulus>E</youngs_modulus>
        <poissons_ratio>nu</poissons_ratio>
    </add>
    <add sel="/*/media/medium[@id='0']/phases/phase[type='Solid']/properties">
        <property>
            <name>swelling_stress_rate</name>
            <type>SaturationDependentSwelling</type>
            <swelling_pressures>1000000.0 1500000.0 1000000.0</swelling_pressures>
            <exponents>1 1 1</exponents>
            <lower_saturation_limit>0</lower_saturation_limit>
            <upper_saturation_limit>1</upper_saturation_limit>
        </property>
    </add>
    <remove sel="/*/parameters/parameter[name='bishops_model_type']"/>
    <remove sel="/*/parameters/parameter[name='bishops_model_value']"/>
    <remove sel="/*/parameters/parameter[name='S_L_res']"/>
    <remove sel="/*/parameters/parameter[name='S_G_res']"/>
    <remove sel="/*/parameters/parameter[name='p_b']"/>
    <remove sel="/*/parameters/parameter[name='m_S']"/>
    <remove sel="/*/parameters/parameter[name='max_swelling_pressure_x']"/>
    <remove sel="/*/parameters/parameter[name='max_swelling_pressure_y']"/>
    <remove sel="/*/parameters/parameter[name='max_swelling_pressure_z']"/>
    <remove sel="/*/parameters/parameter[name='swelling_exponent_x']"/>
    <remove sel="/*/parameters/parameter[name='swelling_exponent_y']"/>
    <remove sel="/*/parameters/parameter[name='swelling_exponent_z']"/>
    <remove sel="/*/parameters/parameter[name='lower_saturation_limit']"/>
    <remove sel="/*/parameters/parameter[name='upper_saturation_limit']"/>
    <remove sel="/*/test_definition"/>
    <add sel="/*">
        <test_definition>
            <vtkdiff>
                <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
                <field>displacement</field>
                <absolute_tolerance>2e-13</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
                <field>epsilon</field>
                <absolute_tolerance>2e-11</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
                <field>pressure</field>
                <absolute_tolerance>5e-4</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
                <field>saturation</field>
                <absolute_tolerance>3e-12</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
                <field>NodalForces</field>
                <absolute_tolerance>2e-7</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
                <field>swelling_stress</field>
                <absolute_tolerance>5e-6</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
                <field>temperature</field>
                <absolute_tolerance>1e-10</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
</OpenGeoSysProjectDiff>
