<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProject>
    <meshes>
        <mesh axially_symmetric="true">Sandwich-0a-Oe-0-2Daxisym.vtu</mesh>
        <mesh axially_symmetric="true">Sandwich-0a-Oe-0-2Daxisym-Bottom.vtu</mesh>
        <mesh axially_symmetric="true">Sandwich-0a-Oe-0-2Daxisym-Right.vtu</mesh>
        <mesh axially_symmetric="true">Sandwich-0a-Oe-0-2Daxisym-Left.vtu</mesh>
        <mesh axially_symmetric="true">Sandwich-0a-Oe-0-2Daxisym-Top.vtu</mesh>
    </meshes>
    <processes>
        <process>
            <name>TRM</name>
            <type>THERMO_RICHARDS_MECHANICS</type>
            <subtype>StressSaturation_StrainPressureTemperature</subtype>
            <integration_order>2</integration_order>
            <mass_lumping>true</mass_lumping>
            <process_variables>
                <temperature>temperature</temperature>
                <pressure>pressure</pressure>
                <displacement>displacement</displacement>
            </process_variables>
            <secondary_variables>
                <secondary_variable internal_name="epsilon" output_name="epsilon"/>
                <secondary_variable internal_name="saturation" output_name="saturation"/>
                <secondary_variable internal_name="swelling_stress" output_name="swelling_stress"/>
            </secondary_variables>
            <specific_body_force>0 0</specific_body_force>
            <constitutive_relation>
                <type>MFront</type>
                <behaviour>ThermoPoroElasticitySwelling</behaviour>
                <material_properties>
                    <material_property name="YoungModulus" parameter="E"/>
                    <material_property name="PoissonRatio" parameter="nu"/>
                    <material_property name="ThermalExpansion" parameter="alpha"/>
                    <material_property name="BiotCoefficient" parameter="alpha_B"/>
                    <material_property name="BishopsModelType" parameter="bishops_model_type"/>
                    <material_property name="BishopsModelValue" parameter="bishops_model_value"/>
                    <material_property name="ResidualLiquidSaturation" parameter="S_L_res"/>
                    <material_property name="ResidualGasSaturation" parameter="S_G_res"/>
                    <material_property name="BubblePressure" parameter="p_b"/>
                    <material_property name="VanGenuchtenExponent_m" parameter="m_S"/>
                    <material_property name="SwellingPressures[0]" parameter="max_swelling_pressure_x"/>
                    <material_property name="SwellingPressures[1]" parameter="max_swelling_pressure_y"/>
                    <material_property name="SwellingPressures[2]" parameter="max_swelling_pressure_z"/>
                    <material_property name="Exponents[0]" parameter="swelling_exponent_x"/>
                    <material_property name="Exponents[1]" parameter="swelling_exponent_y"/>
                    <material_property name="Exponents[2]" parameter="swelling_exponent_z"/>
                    <material_property name="LowerSaturationLimit" parameter="lower_saturation_limit"/>
                    <material_property name="UpperSaturationLimit" parameter="upper_saturation_limit"/>
                </material_properties>
            </constitutive_relation>
            <initial_stress type="total">initial_stress</initial_stress>
        </process>
    </processes>
    <media>
        <medium id="0">
            <phases>
                <phase>
                    <type>AqueousLiquid</type>
                    <properties>
                        <property>
                            <name>specific_heat_capacity</name>
                            <type>Constant</type>
                            <value>4280.0</value>
                        </property>
                        <property>
                            <name>thermal_conductivity</name>
                            <type>Constant</type>
                            <value>0.6</value>
                        </property>
                        <property>
                            <name>density</name>
                            <type>Function</type>
                            <value>
                                <expression>1000*exp(4.5e-10*(max(0,liquid_phase_pressure)-1e5))*(1 - 1e-5*(temperature - 293.15))</expression>
                            </value>
                            <dvalue>
                                <variable_name>liquid_phase_pressure</variable_name>
                                <expression>4.5e-10*max(0, sgn(liquid_phase_pressure))*1000*exp(4.5e-10*(max(0, liquid_phase_pressure)-1e5))*(1 - 1e-5*(temperature - 293.15))</expression>
                            </dvalue>
                            <dvalue>
                                <variable_name>temperature</variable_name>
                                <expression>-1e-5*1000*exp(4.5e-10*(max(0,liquid_phase_pressure)-1e5))</expression>
                            </dvalue>
                        </property>
                        <property>
                            <name>viscosity</name>
                            <type>Constant</type>
                            <value>1e-3</value>
                        </property>
                    </properties>
                </phase>
                <phase>
                    <type>Solid</type>
                    <properties>
                        <property>
                            <name>density</name>
                            <type>Constant</type>
                            <value>2749.956</value>
                        </property>
                        <property>
                            <name>thermal_conductivity</name>
                            <type>Constant</type>
                            <value>1.838</value>
                        </property>
                        <property>
                            <name>specific_heat_capacity</name>
                            <type>Constant</type>
                            <value>917.654</value>
                        </property>
                        <property>
                            <name>thermal_expansivity</name>
                            <type>Parameter</type>
                            <parameter_name>alpha</parameter_name>
                        </property>
                    </properties>
                </phase>
            </phases>
            <properties>
                <property>
                    <name>porosity</name>
                    <type>Constant</type>
                    <value>0.4349</value>
                </property>
                <property>
                    <name>biot_coefficient</name>
                    <type>Parameter</type>
                    <parameter_name>alpha_B</parameter_name>
                </property>
                <property>
                    <name>permeability</name>
                    <type>Parameter</type>
                    <parameter_name>intrinsic_permeability</parameter_name>
                </property>
                <property>
                    <name>relative_permeability</name>
                    <type>RelativePermeabilityGeneralizedPower</type>
                    <residual_liquid_saturation>0.0</residual_liquid_saturation>
                    <residual_gas_saturation>0.0</residual_gas_saturation>
                    <min_relative_permeability>1e-20</min_relative_permeability>
                    <exponent>0.5</exponent>
                </property>
                <property>
                    <name>thermal_conductivity</name>
                    <type>EffectiveThermalConductivityPorosityMixing</type>
                </property>
                <property>
                    <name>saturation</name>
                    <type>SaturationVanGenuchten</type>
                    <p_b>22400000.0</p_b>
                    <exponent>0.359</exponent>
                    <residual_liquid_saturation>0.0</residual_liquid_saturation>
                    <residual_gas_saturation>0.0</residual_gas_saturation>
                </property>
                <property>
                    <name>bishops_effective_stress</name>
                    <type>BishopsPowerLaw</type>
                    <exponent>0.5</exponent>
                </property>
            </properties>
        </medium>
    </media>
    <time_loop>
        <processes>
            <process ref="TRM">
                <nonlinear_solver>basic_newton</nonlinear_solver>
                <convergence_criterion>
                    <type>PerComponentDeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <reltols>1e-10 1e-10 1e-10 1e-10</reltols>
                    <abstols>1e-10 1e-3 1e-12 1e-12</abstols>
                </convergence_criterion>
                <time_discretization>
                    <type>BackwardEuler</type>
                </time_discretization>
                <time_stepping>
                    <type>FixedTimeStepping</type>
                    <t_initial>0</t_initial>
                    <t_end>172800</t_end>
                    <timesteps>
                        <pair>
                            <repeat>100</repeat>
                            <delta_t>864.0</delta_t>
                        </pair>
                        <pair>
                            <repeat>100</repeat>
                            <delta_t>432.0</delta_t>
                        </pair>
                        <pair>
                            <repeat>100</repeat>
                            <delta_t>432.0</delta_t>
                        </pair>
                    </timesteps>
                </time_stepping>
            </process>
        </processes>
        <output>
            <type>VTK</type>
            <prefix>non_isothermal_constant_volume_swelling_mfront</prefix>
            <output_iteration_results>false</output_iteration_results>
            <variables>
            </variables>
            <fixed_output_times>0 21600 43200 64800 86400 97200 108000 118800 129600 151200 172800</fixed_output_times>
            <suffix>_{:time}</suffix>
        </output>
    </time_loop>
    <parameters>
        <parameter>
            <name>E</name>
            <type>Constant</type>
            <value>18000000.0</value>
        </parameter>
        <parameter>
            <name>nu</name>
            <type>Constant</type>
            <value>0.35</value>
        </parameter>
        <parameter>
            <name>alpha</name>
            <type>Constant</type>
            <value>1e-05</value>
        </parameter>
        <parameter>
            <name>alpha_B</name>
            <type>Constant</type>
            <value>0.95</value>
        </parameter>
        <parameter>
            <name>bishops_model_type</name>
            <type>Constant</type>
            <value>0</value>
        </parameter>
        <parameter>
            <name>bishops_model_value</name>
            <type>Constant</type>
            <value>0.5</value>
        </parameter>
        <parameter>
            <name>intrinsic_permeability</name>
            <type>Constant</type>
            <value>2e-19</value>
        </parameter>
        <parameter>
            <name>S_L_res</name>
            <type>Constant</type>
            <value>0.0</value>
        </parameter>
        <parameter>
            <name>S_G_res</name>
            <type>Constant</type>
            <value>0.0</value>
        </parameter>
        <parameter>
            <name>p_b</name>
            <type>Constant</type>
            <value>22400000.0</value>
        </parameter>
        <parameter>
            <name>m_S</name>
            <type>Constant</type>
            <value>0.359</value>
        </parameter>
        <parameter>
            <name>max_swelling_pressure_x</name>
            <type>Constant</type>
            <value>1000000.0</value>
        </parameter>
        <parameter>
            <name>max_swelling_pressure_y</name>
            <type>Constant</type>
            <value>1500000.0</value>
        </parameter>
        <parameter>
            <name>max_swelling_pressure_z</name>
            <type>Constant</type>
            <value>1000000.0</value>
        </parameter>
        <parameter>
            <name>swelling_exponent_x</name>
            <type>Constant</type>
            <value>1</value>
        </parameter>
        <parameter>
            <name>swelling_exponent_y</name>
            <type>Constant</type>
            <value>1</value>
        </parameter>
        <parameter>
            <name>swelling_exponent_z</name>
            <type>Constant</type>
            <value>1</value>
        </parameter>
        <parameter>
            <name>lower_saturation_limit</name>
            <type>Constant</type>
            <value>0</value>
        </parameter>
        <parameter>
            <name>upper_saturation_limit</name>
            <type>Constant</type>
            <value>1</value>
        </parameter>
        <parameter>
            <name>displacement_ic</name>
            <type>Constant</type>
            <values>0 0</values>
        </parameter>
        <parameter>
            <name>temperature_ic</name>
            <type>Constant</type>
            <value>293.15</value>
        </parameter>
        <parameter>
            <name>one</name>
            <type>Constant</type>
            <value>1</value>
        </parameter>
        <parameter>
            <name>temperature_bottom</name>
            <type>CurveScaled</type>
            <curve>temperature_bottom_curve</curve>
            <parameter>one</parameter>
        </parameter>
        <parameter>
            <name>dirichlet</name>
            <type>Constant</type>
            <values>0</values>
        </parameter>
        <parameter>
            <name>initial_stress</name>
            <type>Constant</type>
            <values>0.0 0.0 0.0 0.0</values>
        </parameter>
        <parameter>
            <name>pressure_ic</name>
            <type>Constant</type>
            <value>-96120204.73101392</value>
        </parameter>
        <parameter>
            <name>pressure_bc</name>
            <type>Constant</type>
            <value>20000</value>
        </parameter>
    </parameters>
    <curves>
        <curve>
            <name>temperature_bottom_curve</name>
            <coords>0 86400 129600 172800</coords>
            <values>293.15 293.15 353.15 353.15</values>
        </curve>
    </curves>
    <process_variables>
        <process_variable>
            <name>displacement</name>
            <components>2</components>
            <order>1</order>
            <initial_condition>displacement_ic</initial_condition>
            <boundary_conditions>
                <boundary_condition>
                    <mesh>Sandwich-0a-Oe-0-2Daxisym-Bottom</mesh>
                    <type>Dirichlet</type>
                    <component>1</component>
                    <parameter>dirichlet</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>Sandwich-0a-Oe-0-2Daxisym-Right</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>dirichlet</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>Sandwich-0a-Oe-0-2Daxisym-Left</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>dirichlet</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>Sandwich-0a-Oe-0-2Daxisym-Top</mesh>
                    <type>Dirichlet</type>
                    <component>1</component>
                    <parameter>dirichlet</parameter>
                </boundary_condition>
            </boundary_conditions>
        </process_variable>
        <process_variable>
            <name>pressure</name>
            <components>1</components>
            <order>1</order>
            <initial_condition>pressure_ic</initial_condition>
            <boundary_conditions>
                <boundary_condition>
                    <mesh>Sandwich-0a-Oe-0-2Daxisym-Bottom</mesh>
                    <type>Dirichlet</type>
                    <parameter>pressure_bc</parameter>
                </boundary_condition>
            </boundary_conditions>
        </process_variable>
        <process_variable>
            <name>temperature</name>
            <components>1</components>
            <order>1</order>
            <initial_condition>temperature_ic</initial_condition>
            <boundary_conditions>
                <boundary_condition>
                    <mesh>Sandwich-0a-Oe-0-2Daxisym-Bottom</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>temperature_bottom</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>Sandwich-0a-Oe-0-2Daxisym-Top</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>temperature_ic</parameter>
                </boundary_condition>
            </boundary_conditions>
        </process_variable>
    </process_variables>
    <nonlinear_solvers>
        <nonlinear_solver>
            <name>basic_newton</name>
            <type>Newton</type>
            <max_iter>50</max_iter>
            <linear_solver>linear_solver</linear_solver>
        </nonlinear_solver>
    </nonlinear_solvers>
    <linear_solvers>
        <linear_solver>
            <name>linear_solver</name>
            <eigen>
                <solver_type>SparseLU</solver_type>
            </eigen>
            <petsc>
                <parameters>-ksp_type gmres
                    -pc_type lu -pc_factor_zeropivot 0
                    -ksp_rtol 1.e-12 -ksp_atol 1.e-12
                </parameters>
            </petsc>
        </linear_solver>
    </linear_solvers>
    <test_definition>
        <vtkdiff>
            <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
            <field>displacement</field>
            <absolute_tolerance>1e-14</absolute_tolerance>
            <relative_tolerance>0</relative_tolerance>
        </vtkdiff>
        <vtkdiff>
            <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
            <field>epsilon</field>
            <absolute_tolerance>1e-13</absolute_tolerance>
            <relative_tolerance>0</relative_tolerance>
        </vtkdiff>
        <vtkdiff>
            <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
            <field>pressure</field>
            <absolute_tolerance>5e-6</absolute_tolerance>
            <relative_tolerance>0</relative_tolerance>
        </vtkdiff>
        <vtkdiff>
            <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
            <field>saturation</field>
            <absolute_tolerance>1e-13</absolute_tolerance>
            <relative_tolerance>0</relative_tolerance>
        </vtkdiff>
        <vtkdiff>
            <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
            <field>NodalForces</field>
            <absolute_tolerance>2e-7</absolute_tolerance>
            <relative_tolerance>0</relative_tolerance>
        </vtkdiff>
        <vtkdiff>
            <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
            <field>swelling_stress</field>
            <absolute_tolerance>1e-6</absolute_tolerance>
            <relative_tolerance>0</relative_tolerance>
        </vtkdiff>
        <vtkdiff>
            <regex>non_isothermal_constant_volume_swelling_mfront_.*[.]vtu</regex>
            <field>temperature</field>
            <absolute_tolerance>1e-10</absolute_tolerance>
            <relative_tolerance>0</relative_tolerance>
        </vtkdiff>
    </test_definition>
</OpenGeoSysProject>
