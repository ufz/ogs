<?xml version='1.0' encoding='ISO-8859-1'?>
<!-- The Richards flow benchmark solved by the staggered HM process with mass
     lumping. The displacement is fixed in the entire domain and the fixed
     stress stabilization parameter is zero, so that there is no artificial
     storage of the fixed stress splitting and the pressure must equal the
     result of the Richards flow process for the same parameters.

     The storage matrix is the only matrix term mass lumping affects, so it
     must be neither zero nor irrelevant at the recorded times:
     - a Biot coefficient of 0.9 gives the HM storage coefficient
       (alpha - porosity) (1 - alpha) / K_S a value of 3.0e-12, which is set as
       the `storage` property the Richards flow process reads;
     - a viscosity of 1 Pa s puts the diffusion time S mu / K of the unit
       square at 3 s, so the pressure is still transient at t = 1 and t = 2.
       In the steady state the storage term drops out and mass lumping would
       not change the result.

     The reference files are the results of the Richards flow process for these
     parameters. Without mass lumping this project differs from them by about
     6e-4, so the test fails if the lumping is not applied. -->
<OpenGeoSysProjectDiff base_file="flow_fully_saturated.prj">
    <replace sel="/*/processes/process/name/text()">HM</replace>
    <replace sel="/*/processes/process/type/text()">HYDRO_MECHANICS</replace>
    <replace sel="/*/processes/process/mass_lumping/text()">true</replace>
    <remove sel="/*/processes/process/jacobian_assembler"/>
    <remove sel="/*/processes/process/process_variables"/>
    <add sel="/*/processes/process">
        <process_variables>
            <pressure>pressure</pressure>
            <displacement>displacement</displacement>
        </process_variables>
    </add>
    <remove sel="/*/processes/process/secondary_variables"/>
    <add sel="/*/processes/process">
        <secondary_variables>
            <secondary_variable name="velocity"/>
        </secondary_variables>
    </add>
    <add sel="/*/processes/process">
        <coupling_scheme>
            <type>staggered</type>
            <fixed_stress_stabilization_parameter>0</fixed_stress_stabilization_parameter>
        </coupling_scheme>
        <constitutive_relation>
            <type>LinearElasticIsotropic</type>
            <youngs_modulus>E</youngs_modulus>
            <poissons_ratio>nu</poissons_ratio>
        </constitutive_relation>
    </add>

    <!-- The Richards flow storage that matches the HM one, see above. -->
    <replace sel="/*/media/medium/properties/property[name=&quot;storage&quot;]/value/text()">3e-12</replace>
    <replace sel="/*/media/medium/phases/phase/properties/property[name=&quot;viscosity&quot;]/value/text()">1</replace>

    <remove sel="/*/media/medium/properties/property[name=&quot;saturation&quot;]"/>
    <remove sel="/*/media/medium/properties/property[name=&quot;relative_permeability&quot;]"/>
    <add sel="/*/media/medium/properties">
        <property>
            <name>biot_coefficient</name>
            <type>Constant</type>
            <value>0.9</value>
        </property>
    </add>

    <add sel="/*/time_loop">
        <global_process_coupling>
            <max_iter>1</max_iter>
            <convergence_criteria>
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1e-14</abstol>
                </convergence_criterion>
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1e-14</abstol>
                </convergence_criterion>
            </convergence_criteria>
        </global_process_coupling>
    </add>
    <replace sel="/*/time_loop/processes/process/@ref">HM</replace>
    <add sel="/*/time_loop/processes">
        <process ref="HM">
            <nonlinear_solver>basic_newton_u</nonlinear_solver>
            <convergence_criterion>
                <type>DeltaX</type>
                <norm_type>NORM2</norm_type>
                <abstol>1e-14</abstol>
            </convergence_criterion>
            <time_discretization>
                <type>BackwardEuler</type>
            </time_discretization>
            <time_stepping>
                <type>FixedTimeStepping</type>
                <t_initial>0</t_initial>
                <t_end>2</t_end>
                <timesteps>
                    <pair>
                        <repeat>2</repeat>
                        <delta_t>1</delta_t>
                    </pair>
                </timesteps>
            </time_stepping>
        </process>
    </add>
    <replace sel="/*/time_loop/output/prefix/text()">flow_fully_saturated_HM_staggered</replace>
    <remove sel="/*/time_loop/output/variables"/>
    <add sel="/*/time_loop/output">
        <variables>
            <variable>pressure</variable>
            <variable>displacement</variable>
            <variable>velocity</variable>
        </variables>
    </add>

    <add sel="/*/parameters">
        <parameter>
            <name>E</name>
            <type>Constant</type>
            <value>1e10</value>
        </parameter>
        <parameter>
            <name>nu</name>
            <type>Constant</type>
            <value>0</value>
        </parameter>
        <parameter>
            <name>displacement_ic</name>
            <type>Constant</type>
            <values>0 0</values>
        </parameter>
    </add>

    <add sel="/*/process_variables">
        <process_variable>
            <name>displacement</name>
            <components>2</components>
            <order>1</order>
            <initial_condition>displacement_ic</initial_condition>
            <boundary_conditions>
                <boundary_condition>
                    <mesh>square_1x1_quad_1e2</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>dirichlet0</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>square_1x1_quad_1e2</mesh>
                    <type>Dirichlet</type>
                    <component>1</component>
                    <parameter>dirichlet0</parameter>
                </boundary_condition>
            </boundary_conditions>
        </process_variable>
    </add>

    <add sel="/*/nonlinear_solvers">
        <nonlinear_solver>
            <name>basic_newton_u</name>
            <type>Newton</type>
            <max_iter>50</max_iter>
            <linear_solver>general_linear_solver</linear_solver>
        </nonlinear_solver>
    </add>

    <remove sel="/*/test_definition"/>
    <add sel="/*">
        <test_definition>
            <vtkdiff>
                <file>flow_fully_saturated_HM_staggered_ts_1_t_1.000000.vtu</file>
                <reference_file>flow_fully_saturated_ts_1_t_1.000000.vtu</reference_file>
                <field>pressure</field>
                <absolute_tolerance>1e-12</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>flow_fully_saturated_HM_staggered_ts_2_t_2.000000.vtu</file>
                <reference_file>flow_fully_saturated_ts_2_t_2.000000.vtu</reference_file>
                <field>pressure</field>
                <absolute_tolerance>1e-12</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
</OpenGeoSysProjectDiff>
