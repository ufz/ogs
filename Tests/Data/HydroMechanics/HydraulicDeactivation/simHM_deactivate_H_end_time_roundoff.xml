<?xml version='1.0' encoding='ISO-8859-1'?>
<OpenGeoSysProjectDiff base_file="simHM_deactivate_H.prj">
    <!-- The time steps do not sum up to the end time exactly: the accumulated
         time of the last time step is one unit in the last place larger than
         the end time, which is also the end of the deactivation time interval.
         The deactivated subdomain must stay deactivated nonetheless. -->
    <replace sel="/*/process_variables/process_variable/deactivated_subdomains/deactivated_subdomain/time_interval/end/text()">1.7341442501528401</replace>
    <replace sel="/*/time_loop/processes/process/time_stepping/t_end/text()">1.7341442501528401</replace>
    <replace sel="/*/time_loop/processes/process/time_stepping/timesteps/pair/repeat/text()">20</replace>
    <replace sel="/*/time_loop/processes/process/time_stepping/timesteps/pair/delta_t/text()">0.13</replace>

    <replace sel="/*/time_loop/output/prefix/text()">hydraulic_deactivation_roundoff</replace>
    <replace sel="/*/time_loop/output/timesteps/pair/each_steps/text()">14</replace>

    <remove sel="/*/test_definition"/>
    <add sel="/*">
        <test_definition>
            <vtkdiff>
                <regex>hydraulic_deactivation_roundoff_ts_.*_t_.*.vtu</regex>
                <field>pressure_active</field>
                <absolute_tolerance>0</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <regex>hydraulic_deactivation_roundoff_ts_.*_t_.*.vtu</regex>
                <field>pressure</field>
                <absolute_tolerance>0</absolute_tolerance>
                <relative_tolerance>1e-12</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <regex>hydraulic_deactivation_roundoff_ts_.*_t_.*.vtu</regex>
                <field>displacement</field>
                <absolute_tolerance>1e-14</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <regex>hydraulic_deactivation_roundoff_ts_.*_t_.*.vtu</regex>
                <field>sigma</field>
                <absolute_tolerance>1e-10</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <regex>hydraulic_deactivation_roundoff_ts_.*_t_.*.vtu</regex>
                <field>epsilon</field>
                <absolute_tolerance>1e-14</absolute_tolerance>
                <relative_tolerance>0</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
</OpenGeoSysProjectDiff>
