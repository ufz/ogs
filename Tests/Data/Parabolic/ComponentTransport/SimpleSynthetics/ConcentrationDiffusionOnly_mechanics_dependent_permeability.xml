            <b3>50.0</b3>
            <minimum_permeability>1.e-20</minimum_permeability>
            <maximum_permeability>1.e-12</maximum_permeability>
        </property>
    </add>
    <add sel="/*/parameters">
        <parameter>
            <name>k0_mechanics_dependent</name>
            <type>Constant</type>
