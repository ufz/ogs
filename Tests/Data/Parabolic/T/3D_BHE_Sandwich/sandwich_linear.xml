<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProjectDiff base_file="sandwich.prj">
    <add sel="/*/processes/process">
        <linear>true</linear>
    </add>
    <replace sel="/*/time_loop/output/prefix/text()">sandwich_linear</replace>
    <remove sel="/*/test_definition"/>
    <add sel="/*">
        <test_definition>
            <vtkdiff>
                <file>sandwich_linear_ts_10_t_600.000000.vtu</file>
                <reference_file>sandwich_ts_10_t_600.000000.vtu</reference_file>
                <field>temperature_BHE1</field>
                <absolute_tolerance>0</absolute_tolerance>
                <relative_tolerance>5e-15</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>sandwich_linear_ts_10_t_600.000000.vtu</file>
                <reference_file>sandwich_ts_10_t_600.000000.vtu</reference_file>
                <field>temperature_soil</field>
                <absolute_tolerance>0</absolute_tolerance>
                <relative_tolerance>1e-13</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
</OpenGeoSysProjectDiff>
