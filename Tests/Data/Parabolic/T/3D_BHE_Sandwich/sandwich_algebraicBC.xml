<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProjectDiff base_file="sandwich.prj">
    <add sel="/*/processes/process">
        <use_algebraic_bc>true</use_algebraic_bc>
    </add>
    <add sel="/*/processes/process">
        <weighting_factor>1000</weighting_factor>
    </add>
    <add sel="/*/processes/process">
        <linear>true</linear>
    </add>
    <replace sel="/*/time_loop/output/prefix/text()">sandwich_algebraic_bc</replace>
    <replace sel="/*/linear_solvers/linear_solver/eigen/solver_type/text()">CG</replace>
    <replace sel="/*/linear_solvers/linear_solver/eigen/precon_type/text()">DIAGONAL</replace>
    <remove sel="/*/test_definition"/>
    <add sel="/*">
        <test_definition>
            <vtkdiff>
                <file>sandwich_algebraic_bc_ts_10_t_600.000000.vtu</file>
                <reference_file>sandwich_ts_10_t_600.000000.vtu</reference_file>
                <field>temperature_BHE1</field>
                <absolute_tolerance>0</absolute_tolerance>
                <relative_tolerance>1e-6</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>sandwich_algebraic_bc_ts_10_t_600.000000.vtu</file>
                <reference_file>sandwich_ts_10_t_600.000000.vtu</reference_file>
                <field>temperature_soil</field>
                <absolute_tolerance>0</absolute_tolerance>
                <relative_tolerance>5e-9</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
</OpenGeoSysProjectDiff>
