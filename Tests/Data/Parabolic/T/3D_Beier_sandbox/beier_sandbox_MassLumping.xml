        <test_definition>
            <vtkdiff>
                <file>beier_sandbox_mass_lumping_ts_10_t_600.000000.vtu</file>
                <reference_file>beier_sandbox_ts_10_t_600.000000.vtu</reference_file>
                <field>temperature_BHE1</field>
                <absolute_tolerance>0</absolute_tolerance>
                <relative_tolerance>1e-6</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>beier_sandbox_mass_lumping_ts_10_t_600.000000.vtu</file>
                <reference_file>beier_sandbox_ts_10_t_600.000000.vtu</reference_file>
                <field>temperature_soil</field>
                <absolute_tolerance>0</absolute_tolerance>
                <relative_tolerance>1e-4</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
</OpenGeoSysProjectDiff>
