<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProjectDiff base_file="square_1e1_calculatesurfaceflux.prj">
    <!-- As square_1e1_calculatesurfaceflux_gravity.xml, but with the mass
         balance equation: the surface flux is the mass flux rho q, i.e.
         zero on top and bottom and +-78.68 * k/mu * 9e6 on left and right. -->
    <add sel="/*/processes/process">
        <equation_balance_type>mass</equation_balance_type>
    </add>
    <replace sel="/*/processes/process/specific_body_force/text()">0.0 -9.81</replace>
    <replace sel='/*/parameters/parameter[name="p0"]/type/text()'>Function</replace>
    <remove sel='/*/parameters/parameter[name="p0"]/value'/>
    <add sel='/*/parameters/parameter[name="p0"]'>
        <expression>1e7 - 9e6 * x - 771.8508 * y</expression>
    </add>
    <replace sel='/*/process_variables/process_variable/boundary_conditions/boundary_condition[mesh="square_1x1_quad_1e1_left"]/parameter/text()'>p0</replace>
    <replace sel='/*/process_variables/process_variable/boundary_conditions/boundary_condition[mesh="square_1x1_quad_1e1_right"]/parameter/text()'>p0</replace>
    <replace sel="/*/time_loop/output/prefix/text()">LF_square_1e1_surfaceflux_gravity_mass_{:meshname}</replace>
    <remove sel="/*/test_definition"/>
    <add sel="/*">
        <test_definition>
            <vtkdiff>
                <file>LF_square_1e1_surfaceflux_gravity_mass_square_1x1_quad_1e1_complete_surface_ts_2_t_0.864000.vtu</file>
                <field>specific_flux</field>
                <absolute_tolerance>1e-7</absolute_tolerance>
                <relative_tolerance>1e-13</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
</OpenGeoSysProjectDiff>
