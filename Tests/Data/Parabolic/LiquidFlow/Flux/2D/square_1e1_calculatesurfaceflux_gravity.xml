<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProjectDiff base_file="square_1e1_calculatesurfaceflux.prj">
    <!-- Hydrostatic in y, linear in x: p = 1e7 - 9e6 x - rho g y with
         rho g = 78.68 * 9.81 = 771.8508. The surface flux on top and bottom
         vanishes, on left and right it is k/mu(y) * 9e6. -->
    <replace sel="/*/processes/process/specific_body_force/text()">0.0 -9.81</replace>
    <!-- The viscosity is a Function of y, so that the surface flux depends on
         the interpolated position that getFlux() builds; a Constant property
         would not tell whether that position is set. p stays the exact
         solution: q_x = k/mu(y) dp/dx has no x dependence, so div q = 0, and
         the top and bottom flux q_y = -k/mu(y) (dp/dy + rho g) is still
         zero. -->
    <remove sel='/*/media/medium/phases/phase/properties/property/name[text()="viscosity"]/..'/>
    <add sel='/*/media/medium/phases/phase/properties'>
        <property>
            <name>viscosity</name>
            <type>Function</type>
            <value>
                <expression>1.295e-4 / (1 + 0.5 * y)</expression>
            </value>
        </property>
    </add>
    <replace sel='/*/parameters/parameter[name="p0"]/type/text()'>Function</replace>
    <remove sel='/*/parameters/parameter[name="p0"]/value'/>
    <add sel='/*/parameters/parameter[name="p0"]'>
        <expression>1e7 - 9e6 * x - 771.8508 * y</expression>
    </add>
    <replace sel='/*/process_variables/process_variable/boundary_conditions/boundary_condition[mesh="square_1x1_quad_1e1_left"]/parameter/text()'>p0</replace>
    <replace sel='/*/process_variables/process_variable/boundary_conditions/boundary_condition[mesh="square_1x1_quad_1e1_right"]/parameter/text()'>p0</replace>
    <replace sel="/*/time_loop/output/prefix/text()">LF_square_1e1_surfaceflux_gravity_{:meshname}</replace>
    <remove sel="/*/test_definition"/>
    <add sel="/*">
        <test_definition>
            <vtkdiff>
                <file>LF_square_1e1_surfaceflux_gravity_square_1x1_quad_1e1_complete_surface_ts_2_t_0.864000.vtu</file>
                <field>specific_flux</field>
                <absolute_tolerance>1e-7</absolute_tolerance>
                <relative_tolerance>1e-13</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>LF_square_1e1_surfaceflux_gravity_square_1x1_quad_1e1_ts_2_t_0.864000.vtu</file>
                <field>pressure</field>
                <absolute_tolerance>1e-7</absolute_tolerance>
                <relative_tolerance>1e-13</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>LF_square_1e1_surfaceflux_gravity_square_1x1_quad_1e1_ts_2_t_0.864000.vtu</file>
                <field>v</field>
                <absolute_tolerance>1e-7</absolute_tolerance>
                <relative_tolerance>1e-13</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
</OpenGeoSysProjectDiff>
