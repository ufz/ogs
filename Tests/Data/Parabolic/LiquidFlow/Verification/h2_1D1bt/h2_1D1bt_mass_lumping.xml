<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProjectDiff base_file="h2_1D1bt.prj">
    <add sel="/*/processes/process">
        <mass_lumping>true</mass_lumping>
    </add>
    <replace sel="/*/time_loop/output/prefix/text()">h2_1D1bt_mass_lumping</replace>
    <remove sel="/*/time_loop/output/data_mode"/>
    <remove sel="/*/time_loop/output/compress_output"/>
    <remove sel="/*/test_definition"/>
    <add sel="/*">
        <test_definition>
            <vtkdiff>
                <file>h2_1D1bt_mass_lumping_ts_500_t_21600.000000.vtu</file>
                <field>pressure</field>
                <absolute_tolerance>1e-5</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <vtkdiff>
                <file>h2_1D1bt_mass_lumping_ts_1000_t_43200.000000.vtu</file>
                <field>pressure</field>
                <absolute_tolerance>1e-5</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
            <!-- Lumped solution must stay close to the consistent one. -->
            <vtkdiff>
                <file>h2_1D1bt_mass_lumping_ts_1000_t_43200.000000.vtu</file>
                <reference_file>h2_1D1bt_ts_1000_t_43200.000000.vtu</reference_file>
                <field>pressure</field>
                <absolute_tolerance>50</absolute_tolerance>
                <relative_tolerance>0.0</relative_tolerance>
            </vtkdiff>
        </test_definition>
    </add>
</OpenGeoSysProjectDiff>
