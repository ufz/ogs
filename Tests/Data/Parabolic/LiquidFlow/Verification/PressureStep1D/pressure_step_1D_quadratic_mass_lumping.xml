<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProjectDiff base_file="pressure_step_1D.prj">
    <!--
        Quadratic elements with HRZ mass lumping. Unlike for linear elements,
        lumping does not make the scheme monotone here: the stiffness matrix of
        quadratic elements has positive off-diagonal entries, so small negative
        pressures (about -6e3 Pa) still appear ahead of the front in the first
        steps.
    -->
    <replace sel="/*/meshes/mesh[1]/text()">line_quadratic.vtu</replace>
    <replace sel="/*/processes/process/integration_order/text()">3</replace>
    <replace sel="/*/process_variables/process_variable/order/text()">2</replace>
    <add sel="/*/processes/process">
        <mass_lumping>true</mass_lumping>
    </add>
    <replace sel="/*/time_loop/output/prefix/text()">pressure_step_1D_quadratic_mass_lumping</replace>
    <replace sel="/*/test_definition/vtkdiff[1]/file/text()">pressure_step_1D_quadratic_mass_lumping_ts_1_t_0.000001.vtu</replace>
    <replace sel="/*/test_definition/vtkdiff[2]/file/text()">pressure_step_1D_quadratic_mass_lumping_ts_199_t_0.010000.vtu</replace>
</OpenGeoSysProjectDiff>
