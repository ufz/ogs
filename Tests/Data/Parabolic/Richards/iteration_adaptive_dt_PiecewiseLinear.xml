<?xml version='1.0' encoding='ISO-8859-1'?>
<OpenGeoSysProjectDiff base_file="RichardsFlow_2d_small_iteration_adaptive_dt.prj">
    <!-- The multipliers are constant over the range of iteration numbers that
         actually occurs in this benchmark, hence PiecewiseLinear and the
         default PiecewiseConstant interpolation must yield the same time step
         sequence and the same results. The base test definition, and with it
         the reference file, is therefore inherited unchanged. -->
    <add sel="/*/time_loop/processes/process/time_stepping">
        <multiplier_interpolation_type>PiecewiseLinear</multiplier_interpolation_type>
    </add>
</OpenGeoSysProjectDiff>
