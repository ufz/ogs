@DSL DefaultGenericBehaviour;
@Behaviour CheckIntegrationFailure;
@Author Aqeel Afzal Chaudhry;
@Date 28 / 09 / 2026;
@Description {
  Check propagation of MFront integration failure diagnostics to OGS.
}

@Gradient StrainStensor eps_total;
eps_total.setGlossaryName("Strain");

@Flux StressStensor sigma;
sigma.setGlossaryName("Stress");

@ProvidesTangentOperator;
@Integrator {
  tfel::raise("MFront unit-test diagnostic");
}
